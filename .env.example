# Copy to .env and fill in. Never commit the real one.
# Both the app and the pipeline read this file.

# --- write database: automation_philip on the master -------------------------
CXAPP_DB_HOST=db01-master.amzmanager.net
CXAPP_DB_USER=
CXAPP_DB_PASSWORD=
CXAPP_DB_NAME=automation_philip

# --- READ-ONLY replica: source data for the pipeline -------------------------
# The pipeline only ever SELECTs here. Never point it at the master, and never
# write to it — Ab's constraint: changes on the replica degrade replication.
MARIADB_HOST=db02-replica.amzmanager.net
MARIADB_PORT=3306
MARIADB_USER=analytics
MARIADB_PASSWORD=

# --- classifier --------------------------------------------------------------
# The classifier uses the OpenAI-compatible client against DeepSeek.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
CX_MODEL=deepseek-chat
CX_MAXTOK=800

# --- app ---------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
# name:uid:password — uid is what corrections.reviewed_by records
APP_USERS=chadia:1089:change-me
CX_APP_URL=https://philip.amzmanager.net

# --- optional ----------------------------------------------------------------
# Where the taxonomy CSVs live (defaults to ./pipeline/taxonomy)
CX_TAXONOMY_DIR=
# Where an approved code is appended so the classifier can emit it
CX_VOCAB_ADDITIONS=
# Who gets the pending-code digest
CX_NOTIFY_TO=
CX_NOTIFY_CC=
SLACK_USER_TOKEN=
# Cloudflare Pages deploy (pipeline only)
CLOUDFLARE_API_TOKEN=
